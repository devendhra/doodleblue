# Port the Express server listens on
PORT=3000

# MongoDB Atlas connection string (get this from your Atlas cluster)
MONGO_URI=

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=

# How long a JWT token stays valid
JWT_EXPIRES_IN=7d

# URL of the frontend app (used by CORS to allow requests from it)
CLIENT_URL=http://localhost:5173

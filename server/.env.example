# Port the Express server listens on
PORT=3000

# MongoDB Atlas connection string (get this from your Atlas cluster).
# Either format works:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dbname   (normal)
#   mongodb://user:pass@host1:27017,host2:27017/?ssl=true&replicaSet=... (use
#   this if your network blocks DNS SRV lookups, e.g. some campus Wi-Fi)
MONGO_URI=

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=

# How long a JWT token stays valid
JWT_EXPIRES_IN=7d

# URL of the frontend app (used by CORS - several origins allowed,
# separated by commas)
CLIENT_URL=http://localhost:5173

